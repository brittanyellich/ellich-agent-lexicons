              "text/markdown",
              "text/plain"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 1024
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "sourceKey": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    }
  }
